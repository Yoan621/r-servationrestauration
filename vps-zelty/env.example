# URL du CRM déployé (sans / final)
CRM_URL=https://r-servationrestauration.vercel.app
# Même valeur que la variable ZELTY_SYNC_SECRET de Vercel (longue chaîne aléatoire)
ZELTY_SYNC_SECRET=
# Clé API Zelty (lecture des réservations) — la même que ZELTY_API_KEY de Vercel
ZELTY_API_KEY=
# Utilisateur back-office Zelty DÉDIÉ (droit sur les réservations seulement)
ZELTY_BO_LOGIN=
ZELTY_BO_PASSWORD=
# Fréquence de relecture Zelty -> CRM, en minutes
SYNC_EVERY_MIN=5
